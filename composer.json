{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.0",
        "daengdeni/authentication-module": "^1.0",
        "daengdeni/basicdata-module": "^1.0",
        "daengdeni/laravel-id-generator": "^1.0",
        "daengdeni/log-reader": "^2.4",
        "daengdeni/logs-module": "^1.0",
        "daengdeni/usermanagement-module": "^1.0",
        "diglactic/laravel-breadcrumbs": "^10.0",
        "joshbrw/laravel-module-installer": "^2.0",
        "laravel/framework": "^12.0",
        "league/flysystem-sftp-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "nwidart/laravel-modules": "^12",
        "opcodesio/log-viewer": "^3.10",
        "owenoj/pdf-password-protect": "^0.9.0",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-pdf": "^1.5",
        "spatie/laravel-permission": "^6.9",
        "tecnickcom/tcpdf": "^6.10",
        "webklex/laravel-pdfmerger": "^1.3",
        "wildside/userstamps": "^3.0"
    },
    "require-dev": {
        "deployer/deployer": "^7.4",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^1.0",
        "laravel/pint": "^1.13",
        "laravel/pulse": "^1.2",
        "laravel/sail": "^1.26",
        "laravel/telescope": "^5.7",
        "laravel/tinker": "^2.9",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "module-dir": "Modules",
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true,
            "joshbrw/laravel-module-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "daengdeni/logs-module",
            "type": "vcs",
            "url": "https://git.putrakuningan.com/daengdeni/logs"
        },
        {
            "name": "daengdeni/usermanagement-module",
            "type": "vcs",
            "url": "https://git.putrakuningan.com/daengdeni/usermanagement"
        },
        {
            "name": "daengdeni/authentication-module",
            "type": "vcs",
            "url": "https://git.putrakuningan.com/daengdeni/authentication"
        },
        {
            "name": "daengdeni/basicdata-module",
            "type": "vcs",
            "url": "https://git.putrakuningan.com/daengdeni/basicdata"
        },
        {
            "name": "daengdeni/basicdata-module",
            "type": "vcs",
            "url": "https://git.putrakuningan.com/daengdeni/basicdata"
        }
    ]
}
