APP_NAME="IGNITE - Yayasan Satriabudi Dharma Setia"
APP_ENV=production
APP_KEY=base64:XG8d2Lq1B3i4rKz5a6b7c8d9e0f1g2h3i4j5k6l7m8n=
APP_DEBUG=false
APP_TIMEZONE="Asia/Jakarta"
APP_URL=https://ignite.ysds.or.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# Konfigurasi Database Produksi (MySQL/MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_database_produksi
DB_USERNAME=user_database_produksi
DB_PASSWORD=password_database_produksi

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=ysds_ignite_

# Konfigurasi Mail Server (SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.ysds.or.id
MAIL_PORT=465
MAIL_USERNAME=noreply@ysds.or.id
MAIL_PASSWORD=password_email_anda
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@ysds.or.id"
MAIL_FROM_NAME="${APP_NAME}"
